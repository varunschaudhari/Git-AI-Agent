{
    "manifest_version": 3,
    "name": "GitHub Issue Creator",
    "version": "1.0",
    "description": "A Chrome extension to create GitHub issues directly from a popup.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://api.github.com/repos/*",
        "https://api.openai.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}